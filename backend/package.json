{
  "name": "@carp-partners/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Carp Partners TV — Node.js + Express + PostgreSQL + Redis",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js up",
    "migrate:status": "node db/migrate.js status",
    "migrate:stripe": "node ../scripts/migrate-stripe.js",
    "send-campaign": "node ../scripts/send-launch-campaign.js",
    "backfill-stripe-created": "node ../scripts/backfill-stripe-created-at.js",
    "diagnose-missing-subs": "node ../scripts/diagnose-missing-subscriptions.js",
    "bridge-schedule-subs": "node ../scripts/bridge-schedule-subscriptions.js",
    "reconcile-webhook-gap": "node ../scripts/reconcile-webhook-gap.js",
    "relink-duplicate-customers": "node ../scripts/relink-duplicate-customers.js",
    "test": "node --test tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "sanitize-html": "^2.17.5",
    "stripe": "^17.4.0",
    "ua-parser-js": "^1.0.41",
    "zod": "^3.24.1"
  }
}
