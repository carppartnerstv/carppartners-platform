# Copia este archivo a .env.local (no se commitea, el .gitignore raíz del
# monorepo ya ignora *.env*). Sin ningún .env.local, la app usa
# http://localhost:3001 por defecto (fallback en lib/apiClient.ts) — crea
# este archivo cuando quieras apuntar a otro sitio, por ejemplo producción:
EXPO_PUBLIC_API_URL=https://app.carppartners.tv/api

# O contra tu backend local desde el móvil físico en la misma WiFi (no
# "localhost", el propio teléfono necesita la IP de tu Mac en la red):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3001
